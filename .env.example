# Copy public values to web/.env.local after deployment. Never include secrets.
NEXT_PUBLIC_API_URL=http://localhost:4051
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Backend local defaults. AWS Lambda receives these from SAM.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AI_ENABLED=false
AI_DAILY_CALL_LIMIT=30
AI_OUTPUT_TOKENS=500
# LINE credentials belong in Secrets Manager, not in this file.
LINE_SECRET_ARN=
